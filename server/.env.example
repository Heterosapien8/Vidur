# Vidur Server Environment Variables
# Copy this to .env (which is strictly git-ignored and never committed)

# Server Port
PORT=3000

# OPTION 1: Groq API Key (High-Speed Inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 2: Anthropic API Key (Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
